%{
#include <stdio.h>
#include <string.h>

char type1[20] = "";
char type2[20] = "";
int count = 0;
%}

%option noyywrap

%%
"int"       { strcpy(yytext, yytext); printf("Data type: int\n"); }
"float"     { printf("Data type: float\n"); }
"char"      { printf("Data type: char\n"); }
"double"    { printf("Data type: double\n"); }

[a-zA-Z_][a-zA-Z0-9_]* {
                if (count == 0)
                    strcpy(type1, "identifier");
                printf("Identifier: %s\n", yytext);
            }

[0-9]+      { printf("Integer constant: %s\n", yytext); }
[0-9]+"."[0-9]+ { printf("Float constant: %s\n", yytext); }

[=,+*/();]  { printf("Operator/Symbol: %s\n", yytext); }

[ \t\n]+    { /* Ignore whitespace */ }

.           { printf("Invalid character: %s\n", yytext); }
%%

int main()
{
    printf("Enter variable declarations:\n");
    yylex();
    return 0;
}
